#ifndef _DEDUP_H
#define _DEDUP_H
#include <tcl.h>

#if HAVE_CONFIG_H
# include <config.h>
#endif

/* Tcl 8.6 has no Tcl_Size (TIP 660): provide it as Tcl 8.7's tcl.h does.  The
 * guards let this coexist with a consumer's own polyfill (such as teabase's
 * config.h #define Tcl_Size int), whichever comes first. */
#if TCL_MAJOR_VERSION < 9 && !defined(TCL_SIZE_MAX)
#	ifndef Tcl_Size
		typedef int Tcl_Size;
#	endif
#	define TCL_SIZE_MAX ((int)(((unsigned int)-1)>>1))
#	ifndef TCL_SIZE_MODIFIER
#		define TCL_SIZE_MODIFIER ""
#	endif
#endif

#ifdef __cplusplus
extern "C" {
#endif

#ifdef BUILD_dedup
#undef TCL_STORAGE_CLASS
#define TCL_STORAGE_CLASS DLLEXPORT
#endif

typedef void dedup_pool;

/* Stubs exported API */

#ifdef USE_DEDUP_STUBS
extern const char* DedupInitializeStubs(Tcl_Interp* interp);
#define Dedup_InitStubs(interp)	DedupInitializeStubs((interp))
#else
#define Dedup_InitStubs(interp)	Tcl_PkgRequire((interp), "@PACKAGE_NAME@", "@PACKAGE_VERSION@", 0)
#endif

#include "dedupDecls.h"

EXTERN int Dedup_Init(Tcl_Interp *interp);

#ifdef __cplusplus
}
#endif
#endif
